<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Spooky Birthday, Tamtsiko! 🦇</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: radial-gradient(circle at center, #2a153d 0%, #0d0614 100%);
            font-family: 'Georgia', serif;
            overflow: hidden;
            color: #fff;
        }

        /* ფონური ობობის ქსელი კუთხეში */
        .web-corner {
            position: fixed;
            top: 0;
            left: 0;
            width: 150px;
            height: 150px;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 100 100' xmlns='http://w3.org d='M0 0 L100 0 M0 0 L85 50 M0 0 L50 85 M0 0 L0 100 M20 0 Q15 15 0 20 M40 0 Q30 30 0 40 M60 0 Q45 45 0 60 M80 0 Q60 60 0 80' stroke='%239b59b6' stroke-width='1' fill='none' opacity='0.3'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        .container {
            position: relative;
            width: 300px;
            height: 360px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        /* კუბოს ფორმის ყუთი (ფოტოს ფერებში) */
        .coffin-base {
            position: relative;
            width: 220px;
            height: 320px;
            background: #1a0d26;
            clip-path: polygon(25% 0%, 75% 0%, 100% 30%, 80% 100%, 20% 100%, 0% 30%);
            border: 4px solid #ff7518;
            box-shadow: 0 0 30px rgba(155, 89, 182, 0.5);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2;
        }

        /* კუბოს სახურავი */
        .coffin-lid {
            position: absolute;
            width: 220px;
            height: 320px;
            background: linear-gradient(135deg, #7d3c98 0%, #4a235a 100%);
            clip-path: polygon(25% 0%, 75% 0%, 100% 30%, 80% 100%, 20% 100%, 0% 30%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            z-index: 5;
            transition: transform 0.8s cubic-bezier(0.68, -0.55, 0.27, 1.55), opacity 0.6s ease;
            box-shadow: inset 0 0 20px #ff7518;
        }

        .container.open .coffin-lid {
            transform: translateX(260px) rotate(25deg);
            opacity: 0;
            pointer-events: none;
        }

        .skull-icon {
            font-size: 65px;
            margin-bottom: 10px;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.5));
        }

        .lid-title {
            font-size: 22px;
            font-weight: bold;
            color: #ff7518;
            text-shadow: 2px 2px 0px #1a0d26;
            margin: 0;
            letter-spacing: 1px;
        }

        .lid-sub {
            font-size: 13px;
            color: #f5eef8;
            margin-top: 8px;
            font-style: italic;
        }

        /* მისალოცი ბარათი შიგნით */
        .card {
            position: absolute;
            width: 280px;
            background: #fdf2e9;
            color: #1a0d26;
            border: 3px solid #7d3c98;
            border-radius: 12px;
            padding: 18px;
            box-sizing: border-box;
            text-align: center;
            z-index: 4;
            transform: scale(0.3);
            opacity: 0;
            transition: all 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.2s;
            box-shadow: 0 15px 35px rgba(0,0,0,0.8);
        }

        .container.open .card {
            transform: scale(1);
            opacity: 1;
        }

        .card h2 {
            color: #6c3483;
            margin: 0 0 8px 0;
            font-size: 19px;
        }

        .age-joke {
            background: #2c163d;
            color: #ff9f43;
            padding: 8px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: bold;
            margin: 10px 0;
            line-height: 1.4;
        }

        .card p {
            font-size: 13px;
            line-height: 1.5;
            margin: 6px 0;
            color: #2c163d;
        }

        /* ამომფრენი Spooky სიმბოლოები */
        .spooky-float {
            position: absolute;
            font-size: 28px;
            pointer-events: none;
            z-index: 10;
            animation: flyOut 2.5s ease-out forwards;
        }

        @keyframes flyOut {
            0% {
                transform: translate(0, 0) scale(0.5) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translate(var(--tx), var(--ty)) scale(1.3) rotate(var(--rot));
                opacity: 0;
            }
        }
    </style>
</head>
<body>

<div class="web-corner"></div>

<div class="container" id="coffinBox" onclick="openCoffin()">
    <!-- კუბოს შიგთავსი -->
    <div class="coffin-base"></div>

    <!-- მისალოცი ბარათი -->
    <div class="card">
        <h2>Happy Birthday, ტამწიკო! 🦇</h2>
        <p>დღეს ვგლოვობთ შენი 32 წლის ასაკის გარდაცვალებას... 🪦🕯️</p>
        <div class="age-joke">
            ნუ წუწუნებ 33-ზე, მთავარია მეც შენხელა ვარ და ორივე ოფიციალურად Addams Family-ს ვინტაჟური კოლექცია ვხდებით! 🖤💀
        </div>
        <p>იყავი სულ ასეთი გიჟი, საყვარელი და შეუდარებელი! მიყვარხარ უსაზღვროდ! 🍷✨</p>
        <p style="font-weight: bold; color: #6c3483; margin-top: 8px;">შენი დაქალი ანი 🕷️</p>
    </div>

    <!-- კუბოს სახურავი -->
    <div class="coffin-lid">
        <div class="skull-icon">💀</div>
        <h1 class="lid-title">Trick or 33!</h1>
        <p class="lid-sub">დააკლიკე გასახსნელად, ტამწიკო 🕷️</p>
    </div>
</div>

<script>
    let opened = false;

    function openCoffin() {
        if (!opened) {
            const box = document.getElementById('coffinBox');
            box.classList.add('open');
            spawnSpookyItems(box);
            opened = true;
        }
    }

    function spawnSpookyItems(container) {
        const emojis = ['🦇', '💀', '🕷️', '🔮', '🖤', '🎃', '✨', '🦇'];
        for (let i = 0; i < 22; i++) {
            setTimeout(() => {
                const el = document.createElement('div');
                el.className = 'spooky-float';
                el.innerText = emojis[Math.floor(Math.random() * emojis.length)];
                
                el.style.left = '135px';
                el.style.top = '160px';

                const tx = (Math.random() - 0.5) * 420;
                const ty = (Math.random() - 0.6) * 450;
                const rot = (Math.random() - 0.5) * 180;

                el.style.setProperty('--tx', `${tx}px`);
                el.style.setProperty('--ty', `${ty}px`);
                el.style.setProperty('--rot', `${rot}deg`);

                container.appendChild(el);
                setTimeout(() => el.remove(), 2500);
            }, i * 70);
        }
    }
</script>

</body>
</html>
